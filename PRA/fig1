
clear; clc;

%% Parameters
wc = 1;
wa = 1;

Ncut = 40;          % photon basis: |0>,...,|Ncut>
Nlevels = 8;        % number of eigenenergy branches to plot

eta0_list = linspace(0,1.7,220);

etaM_red  = 0.0;    % red dashed: ordinary QRM
etaM_blue = 0.5;    % blue solid: renormalized H0

%% Photon operators
dim_ph = Ncut + 1;

a = diag(sqrt(1:Ncut),1);
adag = a';

Iph = eye(dim_ph);
x = a + adag;        % photon quadrature operator

%% TLS operators
sigz = [1 0; 0 -1];
sigy = [0 -1i; 1i 0];
Itls = eye(2);

%% Total photon number operator
Nop = kron(adag*a, Itls);

%% Storage
E_red  = zeros(Nlevels,length(eta0_list));
E_blue = zeros(Nlevels,length(eta0_list));

%% Main loop
for n = 1:length(eta0_list)

    eta0 = eta0_list(n);

    % ============================================================
    % Red dashed curves:
    % etaM = 0, ordinary gauge-fixed QRM
    %
    % H_QRM = wc a†a
    %       + wa/2 { sigz cos[2x eta0] + sigy sin[2x eta0] }
    % ============================================================

    C0 = matrix_function_x(x, @(lambda) cos(2*eta0*lambda));
    S0 = matrix_function_x(x, @(lambda) sin(2*eta0*lambda));

    Hred = wc*Nop ...
        + (wa/2)*(kron(C0,sigz) + kron(S0,sigy));

    Hred = (Hred + Hred')/2;   % enforce Hermiticity numerically

    er = sort(real(eig(Hred)));
    E_red(:,n) = er(1:Nlevels);


    % ============================================================
    % Blue solid curves:
    % etaM = 0.5, static Floquet component H0
    %
    % H0 = wc a†a
    %    + wa/2 { sigz cos[2x eta0] + sigy sin[2x eta0] }
    %            J0[2x etaM]
    %
    % Important:
    % J0[2x etaM] is a MATRIX FUNCTION, not element-wise besselj.
    % ============================================================

    J0 = matrix_function_x(x, @(lambda) besselj(0,2*etaM_blue*lambda));

    C = matrix_function_x(x, @(lambda) exp(2i*eta0*lambda));
    S = matrix_function_x(x, @(lambda) exp(-2i*eta0*lambda));

    % All are functions of x, so they commute.
    CJ = C * J0;
    SJ = S * J0;

    Hblue = wc*Nop ...
        + (wa/2)*(  kron(CJ,(sigz-1i*sigy)/2) + kron(SJ,(sigz+1i*sigy)/2)   )  ;

    Hblue = (Hblue + Hblue')/2;   % enforce Hermiticity numerically

    eb = sort(real(eig(Hblue)));
    E_blue(:,n) = eb(1:Nlevels);

end

%% Plot
figure; hold on; box on;

for k = 1:Nlevels
    plot(eta0_list,E_red(k,:), 'r--','LineWidth',2);
end

for k = 1:Nlevels
    plot(eta0_list,E_blue(k,:), 'b-','LineWidth',2);
end

xlabel('Static coupling \eta_0');
ylabel('Energy (\omega_c)');

xlim([0 1.7]);
ylim([-0.6 2.6]);

set(gca,'FontSize',14,'LineWidth',1.2);

