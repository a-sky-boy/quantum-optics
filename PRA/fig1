%% ==============================================================
% Local function: matrix function f(x)
% If x = V D V^{-1}, then f(x) = V f(D) V^{-1}
% Since x is Hermitian, V^{-1}=V'
% ==============================================================
function F = matrix_function_x(x, fhandle)

    [V,D] = eig((x+x')/2);
    lambda = real(diag(D));

    f_lambda = fhandle(lambda);

    F = V * diag(f_lambda) * V';

    F = (F + F')/2;  % remove tiny numerical non-Hermitian part
end
